      "configuration" : {
        "scriptLang" : "JS",
        "jsScript" : "// getValues { sensor:[{value,timestamp}] } -> telemetria TB [{ts,values}] (historico completo).\n//\n// CORRECCION DE HORA: con utc=true, Qampo entrega los timestamps asumiendo UTC+1 fijo\n// (hora estandar de Espana, SIN horario de verano). En verano (CEST) eso queda 1h\n// adelantado respecto al UTC real y TB lo mostraria 1h en el futuro. Restamos el\n// desfase de DST de Europe/Madrid: 1h en verano, 0h en invierno. Robusto todo el anio.\nfunction madridOffsetHours(ts) {\n  var d = new Date(ts);\n  var y = d.getUTCFullYear();\n  function lastSundayUtc(year, month) {\n    var last = new Date(Date.UTC(year, month + 1, 0));\n    var dom = last.getUTCDate() - last.getUTCDay();\n    return Date.UTC(year, month, dom, 1, 0, 0);\n  }\n  var dstStart = lastSundayUtc(y, 2);\n  var dstEnd = lastSundayUtc(y, 9);\n  return (ts >= dstStart && ts < dstEnd) ? 2 : 1;\n}\n\nvar resp = msg;\nvar keys = Object.keys(resp);\nvar byTs = {};\nfor (var k = 0; k < keys.length; k++) {\n  var arr = resp[keys[k]];\n  if (!Array.isArray(arr) || arr.length === 0) { continue; }\n  for (var j = 0; j < arr.length; j++) {\n    var v = parseFloat(arr[j].value);\n    if (isNaN(v)) { continue; }\n    var tsQampo = arr[j].timestamp;\n    var ts = tsQampo - (madridOffsetHours(tsQampo) - 1) * 3600000;\n    if (!byTs[ts]) { byTs[ts] = {}; }\n    byTs[ts][keys[k]] = v;\n  }\n}\nvar out = [];\nvar tsKeys = Object.keys(byTs);\nfor (var t = 0; t < tsKeys.length; t++) {\n  out.push({ ts: parseInt(tsKeys[t], 10), values: byTs[tsKeys[t]] });\n}\nreturn { msg: (out.length > 0 ? out : {}), metadata: metadata, msgType: 'POST_TELEMETRY_REQUEST' };",
        "tbelScript" : "return {msg: msg, metadata: metadata, msgType: msgType};"
