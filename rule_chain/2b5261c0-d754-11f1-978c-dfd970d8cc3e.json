      "additionalInfo" : {
        "description" : "Nombre del dispositivo: q-NODEID. Perfil segun sensores.",
        "layoutX" : 1000,
        "layoutY" : 300
      },
      "configuration" : {
        "scriptLang" : "JS",
        "jsScript" : "// Un dispositivo de /devices. Clasifica por sensores REALMENTE conectados\n// (realm != '-' y sensor != 'Not Connected'); prepara nombre, tipo, coords y ventana.\n// NOMBRE: todos los equipos Qampo se llaman q-NODEID (p.ej. q-10391101).\n// El tipo (perfil de dispositivo) se sigue clasificando por sensores.\nvar dev = msg;\nvar nodeid = String(dev.id);\nvar hasSoil = false, hasWeather = false;\nvar sensors = dev.sensors || [];\nfor (var i = 0; i < sensors.length; i++) {\n  var s = sensors[i];\n  if (!s || s.sensor === 'Not Connected') { continue; }\n  if (s.realm === 'soil') { hasSoil = true; }\n  if (s.realm === 'weather') { hasWeather = true; }\n}\nvar deviceType;\nif (hasSoil && hasWeather) { deviceType = 'Estacion agroclimatica'; }\nelse if (hasWeather) { deviceType = 'Estacion meteorologica'; }\nelse if (hasSoil) { deviceType = 'Sonda de humedad de suelo'; }\nelse { deviceType = 'Dispositivo Qampo'; }\n\nmetadata.nodeid = nodeid;\nmetadata.deviceType = deviceType;\nmetadata.deviceName = 'q-' + nodeid;\n\nvar coords = dev.coordinates || {};\nmetadata.lat = (coords.latitude != null) ? String(coords.latitude) : '';\nmetadata.lon = (coords.longitude != null) ? String(coords.longitude) : '';\nmetadata.owner = dev.owner || '';\n\nvar windowHours = 6;\nvar now = Date.now();\nmetadata.ts_end = String(now);\nmetadata.ts_start = String(now - windowHours * 60 * 60 * 1000);\n\nreturn { msg: {}, metadata: metadata, msgType: 'POST_TELEMETRY_REQUEST' };\n",
        "tbelScript" : "return {msg: msg, metadata: metadata, msgType: msgType};"
      },
