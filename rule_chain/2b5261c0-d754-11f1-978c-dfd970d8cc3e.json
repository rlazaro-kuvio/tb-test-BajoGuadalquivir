        "jsScript" : "// Atributos de servidor para el dashboard (mapa, filtro, salud).\nvar attrs = { owner: metadata.owner, qampo_nodeid: metadata.nodeid, funcion: metadata.deviceType };\nif (metadata.lat && metadata.lat !== '') { attrs.latitude = parseFloat(metadata.lat); }\nif (metadata.lon && metadata.lon !== '') { attrs.longitude = parseFloat(metadata.lon); }\nreturn { msg: attrs, metadata: metadata, msgType: 'POST_ATTRIBUTES_REQUEST' };\n",
